# Dependencies
node_modules/

# Frontend build output (Vite)
dist/
.vite/
*.tsbuildinfo

# Rust / Tauri build output
src-tauri/target/
# Regenerated by tauri-build on every build
src-tauri/gen/schemas/

# Tauri updater signing keys (P2) — must only live in CI secrets
*.key
*.key.pub

# Local environment
.env
.env.*.local

# Logs (includes MARKY_PERF_LOG output if pointed inside the repo)
*.log
npm-debug.log*

# Test and coverage output
coverage/

# Claude Code: keep shared launch config, ignore personal settings
.claude/settings.local.json

# graphify knowledge-graph output
graphify-out/

# Editors and OS
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
Thumbs.db
desktop.ini
.DS_Store
